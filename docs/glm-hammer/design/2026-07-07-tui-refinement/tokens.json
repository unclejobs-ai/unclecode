{
  "$schema": "https://design-tokens.org/format",
  "color": {
    "text": {
      "default": { "$value": "#e6edf3", "$type": "color" },
      "muted": { "$value": "#a6adc8", "$type": "color" },
      "dim": { "$value": "#7d8590", "$type": "color" },
      "inverse": { "$value": "#0d1117", "$type": "color" }
    },
    "surface": {
      "default": { "$value": "#000000", "$type": "color" },
      "raised": { "$value": "#0d1117", "$type": "color" },
      "sunken": { "$value": "#1a1b26", "$type": "color" }
    },
    "accent": {
      "primary": { "$value": "#92abdf", "$type": "color" },
      "secondary": { "$value": "#d97757", "$type": "color" }
    },
    "semantic": {
      "success": { "$value": "#9ece6a", "$type": "color" },
      "warning": { "$value": "#e0af68", "$type": "color" },
      "danger": { "$value": "#e28b9b", "$type": "color" }
    },
    "role": {
      "user": { "$value": "#92abdf", "$type": "color" },
      "assistant": { "$value": "#e6edf3", "$type": "color" },
      "tool": { "$value": "#9ece6a", "$type": "color" },
      "system": { "$value": "#e0af68", "$type": "color" }
    },
    "border": {
      "default": { "$value": "#30363d", "$type": "color" },
      "strong": { "$value": "#a6adc8", "$type": "color" },
      "soft": { "$value": "#21262d", "$type": "color" }
    }
  },
  "typography": {
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "emphasis": { "$value": "700", "$type": "fontWeight" }
    },
    "case": {
      "label": { "$value": "sentence", "$type": "textCase" },
      "header": { "$value": "upper", "$type": "textCase" }
    },
    "glyph": {
      "railSoft": { "$value": "▏", "$type": "string" },
      "railUser": { "$value": "│", "$type": "string" },
      "rule": { "$value": "─", "$type": "string" }
    }
  },
  "spacing": {
    "padX": { "$value": "2", "$type": "dimension", "comment": "columns — horizontal padding inside blocks" },
    "gutter": { "$value": "1", "$type": "dimension", "comment": "columns — between rail and content" },
    "sectionGap": { "$value": "1", "$type": "dimension", "comment": "rows — vertical margin between header/status/conversation" },
    "indent": { "$value": "2", "$type": "dimension", "comment": "columns — nested content indent" },
    "statusPadX": { "$value": "2", "$type": "dimension", "comment": "columns — status bar horizontal padding" }
  },
  "radius": {
    "none": { "$value": "0", "$type": "dimension" },
    "panel": { "$value": "0", "$type": "dimension", "comment": "sharp single-line borders, no faux rounded depth" }
  },
  "motion": {
    "spinnerInterval": { "$value": "80ms", "$type": "duration" },
    "spinnerShowDelay": { "$value": "500ms", "$type": "duration", "comment": "Aider-style: do not animate until motion earns its place" },
    "cursorBlink": { "$value": "0ms", "$type": "duration", "comment": "streaming cursor is static — one animated element max" },
    "transition": { "$value": "0ms", "$type": "duration", "comment": "instant glyph swaps; terminal instruments do not ease" }
  }
}
