{
  "$schema": "https://design-tokens.org/schema.json",
  "color": {
    "surface": {
      "default": { "$value": "#0d1117", "$type": "color" },
      "raised": { "$value": "#161b22", "$type": "color" },
      "overlay": { "$value": "#181825", "$type": "color" }
    },
    "border": {
      "subtle": { "$value": "#21262d", "$type": "color" },
      "quiet": { "$value": "#30363d", "$type": "color" },
      "default": { "$value": "#45475a", "$type": "color" },
      "strong": { "$value": "#6c7086", "$type": "color" },
      "accent": { "$value": "#92abdf", "$type": "color" }
    },
    "text": {
      "default": { "$value": "#e6edf3", "$type": "color" },
      "secondary": { "$value": "#cdd6f4", "$type": "color" },
      "muted": { "$value": "#bac2de", "$type": "color" },
      "subtle": { "$value": "#a6adc8", "$type": "color" },
      "dim": { "$value": "#7f849c", "$type": "color" }
    },
    "accent": {
      "user": { "$value": "#92abdf", "$type": "color" },
      "assistant": { "$value": "#94e2d5", "$type": "color" },
      "tool": { "$value": "#9ece6a", "$type": "color" },
      "toolAccent": { "$value": "#73daca", "$type": "color" },
      "success": { "$value": "#a6e3a1", "$type": "color" },
      "warning": { "$value": "#f9e2af", "$type": "color" },
      "error": { "$value": "#f38ba8", "$type": "color" },
      "spinner": { "$value": "#fab387", "$type": "color" }
    }
  },
  "typography": {
    "family": {
      "mono": { "$value": ["JetBrains Mono", "Fira Code", "SF Mono", "Menlo", "Consolas", "monospace"], "$type": "fontFamily" }
    },
    "weight": {
      "regular": { "$value": "Regular", "$type": "fontWeight" },
      "bold": { "$value": "Bold", "$type": "fontWeight" }
    },
    "scale": {
      "body": { "$value": "1rem", "$type": "dimension" }
    }
  },
  "spacing": {
    "gutter": { "$value": "1px", "$type": "dimension" },
    "railIndent": { "$value": "2ch", "$type": "dimension" },
    "sectionGap": { "$value": "1rem", "$type": "dimension" },
    "rowPad": { "$value": "0.25rem", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension" }
  },
  "motion": {
    "spinner": { "$value": "80ms", "$type": "duration" },
    "streamCursor": { "$value": "500ms", "$type": "duration" },
    "spinnerShowDelay": { "$value": "500ms", "$type": "duration" }
  }
}
